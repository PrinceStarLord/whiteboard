# Copy this file to .env for local development.
# On Heroku, DATABASE_URL is set automatically by the Heroku Postgres add-on
# and PORT is set automatically by the dyno — you do not need to set those there.

# Postgres connection string, e.g. postgres://user:password@localhost:5432/retro_board
DATABASE_URL=postgres://postgres:postgres@localhost:5432/retro_board

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Port for local development (Heroku sets this automatically in production)
PORT=3000
